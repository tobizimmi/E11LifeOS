APP_NAME=E11LifeOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Berlin
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mail intake (catch-all mailbox of the server's mail service, fetched via IMAP)
INBOUND_MAIL_DOMAIN=
INBOUND_MAIL_HOST=127.0.0.1
INBOUND_MAIL_PORT=993
INBOUND_MAIL_ENCRYPTION=ssl
INBOUND_MAIL_USERNAME=
INBOUND_MAIL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Claude API: recipe import, nutrition estimates, "Ask your Second Brain", tag suggestions.
# Leave empty to hide the AI features.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Portfolio: optional market data keys (Yahoo Finance works without a key)
TWELVE_DATA_KEY=
OPENFIGI_KEY=
PUSHOVER_APP_TOKEN=
# FinTS bank sync: registered product ID (https://www.hbci-zka.de/register/prod_register.htm)
FINTS_PRODUCT_ID=
# Instagram analysis (Apify token, profile, push key for external pushes)
APIFY_API_KEY=
INSTAGRAM_PROFILE=heikothieme.club
INSTAGRAM_LIMIT=20
INSTAGRAM_PUSH_KEY=

# Portfolio: old portfolio manager database, only for "php artisan portfolio:import-legacy"
PORTFOLIO_LEGACY_DB_HOST=
PORTFOLIO_LEGACY_DB_PORT=3306
PORTFOLIO_LEGACY_DB_DATABASE=
PORTFOLIO_LEGACY_DB_USERNAME=
PORTFOLIO_LEGACY_DB_PASSWORD=

# Web push: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Backups: php artisan backup:run (daily 03:15). Defaults: storage/backups, keep 14.
BACKUP_PATH=
BACKUP_KEEP=14
