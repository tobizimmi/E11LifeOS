# =============================================================================
# E11LifeOS – .env für den Server (Vorlage)
#
# Kopieren nach:  <App-Verzeichnis>/.env   (Live und Staging je eine eigene Datei)
# Alles in <spitzen Klammern> ersetzen. Erklärung zu jedem Wert: docs/env-anleitung.md
# Werte mit Leerzeichen in "Anführungszeichen" setzen.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. App (Pflicht)
# -----------------------------------------------------------------------------
APP_NAME=E11LifeOS
# Live: production · Staging: staging
APP_ENV=production
# Einmalig erzeugen: php artisan key:generate --show  (NIE wieder ändern!)
APP_KEY=<base64:...>
APP_DEBUG=false
# Live: https://zimmimail.de/E11LifeOS · Staging: https://zimmimail.de/E11LifeOS-staging
APP_URL=https://zimmimail.de/E11LifeOS
ASSET_URL=https://zimmimail.de/E11LifeOS

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# 2. Datenbank (Pflicht)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Live: e11lifeos_live · Staging: e11lifeos_staging
DB_DATABASE=e11lifeos_live
DB_USERNAME=e11lifeos
DB_PASSWORD="<starkes-datenbank-passwort>"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# 3. Echtzeit-Updates / Reverb (Pflicht)
#    Eigene Zufallswerte je Umgebung, Live und Staging NICHT teilen.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<zahl, z.B. 481516>
REVERB_APP_KEY=<zufall, z.B. openssl rand -hex 16>
REVERB_APP_SECRET=<zufall, z.B. openssl rand -hex 32>
REVERB_HOST=zimmimail.de
REVERB_PORT=443
REVERB_SCHEME=https
# Live-Updates vom Server direkt an den lokalen Reverb-Prozess (Staging: 3021)
REVERB_PUBLISH_HOST=127.0.0.1
REVERB_PUBLISH_PORT=3011
REVERB_PUBLISH_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
# Live: /E11LifeOS · Staging: /E11LifeOS-staging
VITE_REVERB_PATH=/E11LifeOS

# -----------------------------------------------------------------------------
# 4. E-Mail (für Erinnerungen, Passwort-Reset, Rechnungen/Angebote/Mahnungen)
#    Ohne echten Mailserver: MAIL_MAILER=log (dann wird nichts verschickt).
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-server, z.B. zimmimail.de>
MAIL_PORT=587
MAIL_USERNAME=<postfach, z.B. lifeos@zimmimail.de>
MAIL_PASSWORD="<postfach-passwort>"
MAIL_FROM_ADDRESS="<absender, z.B. lifeos@zimmimail.de>"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# 5. KI (Claude) – Rezept-Import, Verträge auslesen, Kontoauszüge, Second Brain,
#    Instagram-Analyse
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=<sk-ant-...>
ANTHROPIC_MODEL=claude-opus-5

# -----------------------------------------------------------------------------
# 6. Web-Push (Benachrichtigungen im Browser/Handy)
#    Einmalig erzeugen: php artisan webpush:vapid  (danach NIE mehr ändern)
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=<...>
VAPID_PRIVATE_KEY=<...>
VAPID_SUBJECT=mailto:<deine-email>

# -----------------------------------------------------------------------------
# 7. Backups (nächtlich 3:15)
# -----------------------------------------------------------------------------
# Leer = storage/backups im App-Ordner. Besser ein Ordner außerhalb der App.
BACKUP_PATH=
BACKUP_KEEP=14
# Verschlüsselte Kopie außer Haus per WebDAV (z. B. Hetzner Storage Box). Auch auf der Admin-Seite einstellbar.
BACKUP_REMOTE_URL=
BACKUP_REMOTE_USERNAME=
BACKUP_REMOTE_PASSWORD=
# Ohne dieses Passwort lassen sich die Kopien NICHT wiederherstellen – sicher aufbewahren!
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_REMOTE_KEEP=30

# -----------------------------------------------------------------------------
# 7b. Sicherheit & Überwachung (auch auf der Admin-Seite einstellbar)
# -----------------------------------------------------------------------------
# true = alle müssen die Zwei-Faktor-Anmeldung einrichten
SECURITY_REQUIRE_TWO_FACTOR=false
# Fehler auf dem Server per E-Mail melden (höchstens einmal pro Fehler und Stunde)
ERROR_REPORT_EMAIL=

# -----------------------------------------------------------------------------
# 8. Portfolio – Banksync (FinTS/HBCI)
# -----------------------------------------------------------------------------
# Registrierte FinTS-Produkt-ID (ohne sie verweigern die Banken den Zugang)
FINTS_PRODUCT_ID=

# -----------------------------------------------------------------------------
# 9. Portfolio – Instagram-Analyse
# -----------------------------------------------------------------------------
APIFY_API_KEY=
INSTAGRAM_PROFILE=heikothieme.club
INSTAGRAM_LIMIT=20
# Nur nötig, wenn ein anderes Gerät Videos per POST /api/instagram/push schickt
INSTAGRAM_PUSH_KEY=

# -----------------------------------------------------------------------------
# 10. Portfolio – optionale Datenquellen und Pushover
# -----------------------------------------------------------------------------
TWELVE_DATA_KEY=
OPENFIGI_KEY=
PUSHOVER_APP_TOKEN=

# -----------------------------------------------------------------------------
# 11. Einmalige Datenübernahmen: für den Import das # entfernen und ausfüllen,
#     danach wieder auskommentieren
# -----------------------------------------------------------------------------
# Alter Portfolio-Manager (MySQL) → php artisan portfolio:import-legacy <email>
# PORTFOLIO_LEGACY_DB_HOST=
# PORTFOLIO_LEGACY_DB_PORT=3306
# PORTFOLIO_LEGACY_DB_DATABASE=
# PORTFOLIO_LEGACY_DB_USERNAME=
# PORTFOLIO_LEGACY_DB_PASSWORD=

# RezepteApp2 (MySQL) → php artisan recipes:import-rezepteapp <email>
# REZEPTEAPP_DB_HOST=
# REZEPTEAPP_DB_PORT=3306
# REZEPTEAPP_DB_DATABASE=
# REZEPTEAPP_DB_USERNAME=
# REZEPTEAPP_DB_PASSWORD=
